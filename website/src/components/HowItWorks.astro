---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = t(lang).how;
---
<section class="how" id="how">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{h.eyebrow}</span>
      <h2>{h.title}</h2>
      <p>{h.lede}</p>
    </div>
    <div class="diagram">
      <svg viewBox="0 0 960 330" role="img" aria-label={h.d.aria}>
        <defs>
          <linearGradient id="g-wire" x1="0" x2="1"><stop offset="0" style="stop-color:var(--signal)"/><stop offset="1" style="stop-color:var(--violet)"/></linearGradient>
          <radialGradient id="g-halo"><stop offset="0" style="stop-color:var(--signal);stop-opacity:.35"/><stop offset="1" style="stop-color:var(--signal);stop-opacity:0"/></radialGradient>
        </defs>
        <path id="w0" d="M150 165 H300" stroke="var(--line)" stroke-width="2" fill="none" stroke-dasharray="5 7"/>
        <path id="w1" d="M420 150 C520 150 520 80 640 80" stroke="url(#g-wire)" stroke-width="2.5" fill="none"/>
        <path id="w2" d="M420 180 C520 180 520 250 640 250" stroke="url(#g-wire)" stroke-width="2.5" fill="none"/>
        <path id="w3" d="M740 250 H820" stroke="var(--violet)" stroke-width="2" fill="none" stroke-dasharray="4 6"/>
        <g class="pk">
          <circle r="4.5" fill="var(--signal)"><animateMotion dur="1.8s" repeatCount="indefinite"><mpath href="#w0"/></animateMotion></circle>
          <circle r="4.5" fill="var(--signal)"><animateMotion dur="2.2s" begin=".4s" repeatCount="indefinite"><mpath href="#w1"/></animateMotion></circle>
          <circle r="4.5" fill="var(--signal)"><animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite"><mpath href="#w2"/></animateMotion></circle>
          <circle r="4" fill="var(--violet)"><animateMotion dur="1.4s" begin=".7s" repeatCount="indefinite"><mpath href="#w3"/></animateMotion></circle>
        </g>
        <g transform="translate(40 105)">
          <rect width="110" height="110" rx="18" fill="var(--bg-raise)" stroke="var(--line)"/>
          <g transform="translate(31 22)" fill="none" stroke="var(--muted)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M24 22 14 64M24 22l10 42M17 50h14"/><circle cx="24" cy="18" r="4" fill="var(--muted)"/><path d="M12 8a17 17 0 0 0 0 20M36 8a17 17 0 0 1 0 20"/></g>
        </g>
        <text x="95" y="245" text-anchor="middle" class="lbl">{h.d.mobile}</text>
        <text x="95" y="267" text-anchor="middle" class="sub">4G / 5G</text>
        <circle cx="360" cy="165" r="95" fill="url(#g-halo)"/>
        <g transform="translate(325 95)">
          <rect width="70" height="140" rx="14" fill="var(--bg-raise)" stroke="var(--signal)" stroke-width="2"/>
          <rect x="9" y="14" width="52" height="104" rx="5" fill="var(--bg-sunk)"/>
          <g transform="translate(17 46)" fill="none" stroke="var(--signal)" stroke-width="2.6" stroke-linecap="round"><path d="M18 23v16"/><path d="M10 18a11 11 0 0 1 16 0M4 11a19 19 0 0 1 28 0"/></g>
        </g>
        <text x="360" y="268" text-anchor="middle" class="lbl">{h.d.host}</text>
        <text x="360" y="290" text-anchor="middle" class="tag">{h.d.shareMode}</text>
        <text x="520" y="160" text-anchor="middle" class="sub">Wi-Fi Direct</text>
        <g transform="translate(640 30)">
          <rect width="100" height="100" rx="18" fill="var(--bg-raise)" stroke="var(--line)"/>
          <g transform="translate(34 18)" fill="none" stroke="var(--fg)" stroke-width="2.4" stroke-linecap="round"><rect width="32" height="62" rx="6"/><path d="M12 54h8"/></g>
        </g>
        <text x="760" y="70" class="lbl">{h.d.android}</text>
        <text x="760" y="92" class="tag">{h.d.connectMode}</text>
        <g transform="translate(640 200)">
          <rect width="100" height="100" rx="18" fill="var(--bg-raise)" stroke="var(--line)"/>
          <g transform="translate(20 28)" fill="none" stroke="var(--fg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" width="48" height="32" rx="3"/><path d="M0 42h60"/></g>
        </g>
        <text x="690" y="324" text-anchor="middle" class="lbl">{h.d.laptop}</text>
        <g transform="translate(820 200)">
          <rect width="100" height="100" rx="18" fill="var(--bg-raise)" stroke="var(--violet)" stroke-opacity=".55"/>
          <g transform="translate(22 30)" fill="none" stroke="var(--fg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h28a12 12 0 0 1 11.8 14.4l-2.3 11.4a6 6 0 0 1-10.4 2.4L36 26H20l-5.1 6.2a6 6 0 0 1-10.4-2.4L2.2 18.4A12 12 0 0 1 14 4Z"/><path d="M15 12v8M11 16h8"/></g>
        </g>
        <text x="870" y="324" text-anchor="middle" class="lbl">{h.d.console}</text>
        <text x="780" y="238" text-anchor="middle" class="tagv">{h.d.share}</text>
      </svg>
    </div>
    <ol class="how-steps">
      {h.steps.map((s) => <li><h3>{s.title}</h3><p set:html={s.body} /></li>)}
    </ol>
  </div>
</section>
